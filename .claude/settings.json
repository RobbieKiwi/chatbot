{
  "cleanupPeriodDays": 3650,
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m memorylayers summary:*)",
      "Bash(.venv/Scripts/python -m memorylayers recall:*)",
      "Bash(.venv/Scripts/python -m memorylayers facts:*)",
      "Bash(.venv/Scripts/python -m memorylayers search:*)",
      "Bash(.venv/Scripts/python -m memorylayers periods:*)",
      "Bash(.venv/Scripts/python -m memorylayers tags:*)",
      "Bash(.venv/Scripts/python -m memorylayers status:*)",
      "Bash(.venv/Scripts/python -m memorylayers resume:*)",
      "Bash(.venv/Scripts/python -m freshtopics context:*)",
      "Bash(.venv/Scripts/python -m freshtopics seeds:*)",
      "Bash(.venv/Scripts/python -m persona show:*)",
      "Bash(.venv/Scripts/python -m persona set-user:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python -m memorylayers.entry.hook --parent chatbot",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python -m mood.entry.prompt_hook --parent chatbot",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python -m feedback.entry.hook --parent chatbot",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/Scripts/python -m mood.entry.stop_hook --parent chatbot",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
